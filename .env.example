# =============================================================================
# AI Podcast Studio - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env with real secrets.

# --- Database ---
DATABASE_URL="postgresql://podcast:podcast_secret@localhost:5432/ai_podcast?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- S3-compatible Object Storage ---
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="podcast-audio"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# --- Encryption ---
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY="your-256-bit-hex-key-here"

# --- Authentication ---
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# --- Application ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- SSRF Protection ---
# Comma-separated list of allowed private/internal hosts for self-hosted providers
SSRF_ALLOWED_HOSTS=""

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# --- Audio Processing ---
FFMPEG_PATH="/usr/bin/ffmpeg"
AUDIO_TEMP_DIR="/tmp/podcast-audio"
MAX_AUDIO_FILE_SIZE_MB="500"

# --- Provider Defaults ---
DEFAULT_PROVIDER_TIMEOUT_MS="30000"
MAX_PROVIDER_TIMEOUT_MS="120000"
MAX_REQUEST_SIZE_BYTES="10485760"

# --- Google Gemini (LLM script/dialogue generation) ---
# Used by the built-in "Gemini 3.5 Flash Lite" provider (adapterType=GEMINI).
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: override the default model id (default: gemini-3.5-flash-lite)
# GEMINI_MODEL="gemini-3.5-flash-lite"
# Optional: override the API base URL (for proxies)
# GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com"
